{
  "$defs": {
    "AcceptedRisk": {
      "additionalProperties": false,
      "properties": {
        "expires": {
          "description": "Date after which the acceptance is ignored with a warning.",
          "format": "date",
          "title": "Expires",
          "type": "string"
        },
        "id": {
          "description": "Advisory or rule id being accepted.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "package": {
          "anyOf": [
            {
              "maxLength": 214,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Package name the acceptance is limited to. The finding must name it.",
          "title": "Package"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Glob of changed files the acceptance is limited to.",
          "title": "Path"
        },
        "reason": {
          "description": "Why the risk is accepted. Required.",
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason",
        "expires"
      ],
      "title": "AcceptedRisk",
      "type": "object"
    },
    "AgentConfig": {
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "$ref": "#/$defs/Budgets",
          "description": "Per-invocation budgets. Each is capped by the matching limits.* value."
        },
        "enabled": {
          "default": true,
          "description": "Whether this agent runs at all.",
          "title": "Enabled",
          "type": "boolean"
        },
        "fallback_model": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model alias used once after a truncation or overload.",
          "title": "Fallback Model"
        },
        "knowledge_extra_dirs": {
          "description": "Additional knowledge directories the agent may read. Org-only.",
          "items": {
            "type": "string"
          },
          "title": "Knowledge Extra Dirs",
          "type": "array",
          "x-merge": "org_only"
        },
        "max_iterations": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model turns per invocation. Cannot exceed limits.max_iterations.",
          "title": "Max Iterations",
          "x-ceiling": "limits.max_iterations",
          "x-merge": "tighten_only",
          "x-tighten": "le"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model output token cap per call. Cannot exceed limits.max_tokens.",
          "title": "Max Tokens",
          "x-ceiling": "limits.max_tokens",
          "x-merge": "tighten_only",
          "x-tighten": "le"
        },
        "model": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model alias for this agent. Defaults to the agent's built-in alias.",
          "title": "Model"
        },
        "prompt_extra": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra guidance appended to the agent prompt. Untrusted guidance: it cannot override system rules. Length is capped by limits.max_prompt_extra_chars.",
          "title": "Prompt Extra",
          "x-ceiling": "limits.max_prompt_extra_chars",
          "x-merge": "tighten_only"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sampling temperature between 0 and 1.",
          "title": "Temperature"
        },
        "tool_allowlist": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict the agent to these tools. Lower layers may only pick a subset of the base list; null means the agent's full tool set. External-write tools cannot be listed below the org layer.",
          "title": "Tool Allowlist",
          "x-merge": "tighten_only",
          "x-tighten": "subset",
          "x-tool-names": true
        }
      },
      "title": "AgentConfig",
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "tool_calls": {
          "default": 100,
          "description": "Maximum tool calls per invocation. Lower layers may only lower it.",
          "minimum": 1,
          "title": "Tool Calls",
          "type": "integer",
          "x-merge": "tighten_only",
          "x-tighten": "le"
        },
        "wall_clock_seconds": {
          "default": 900,
          "description": "Maximum wall-clock seconds per invocation. Lower layers may only lower it.",
          "minimum": 1,
          "title": "Wall Clock Seconds",
          "type": "integer",
          "x-ceiling": "limits.max_wall_clock_seconds",
          "x-merge": "tighten_only",
          "x-tighten": "le"
        }
      },
      "title": "Budgets",
      "type": "object"
    },
    "ExtraAgent": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "One-line role description.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "description": "Agent id: a lowercase single token, not a built-in id.",
          "pattern": "^[a-z][a-z0-9]{1,30}$",
          "title": "Id",
          "type": "string"
        },
        "knowledge_dirs": {
          "description": "Knowledge directories readable through read_knowledge.",
          "items": {
            "type": "string"
          },
          "title": "Knowledge Dirs",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model alias. Defaults to the platform default.",
          "title": "Model"
        },
        "prompt_path": {
          "description": "Path to the agent prompt markdown file.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Prompt Path",
          "type": "string"
        },
        "routes": {
          "description": "Changed-file globs that route to this agent.",
          "items": {
            "type": "string"
          },
          "title": "Routes",
          "type": "array"
        },
        "tool_preset": {
          "default": "review_readonly",
          "description": "Tool set: review_readonly, or review_publish which adds publish_review.",
          "enum": [
            "review_readonly",
            "review_publish"
          ],
          "title": "Tool Preset",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "prompt_path"
      ],
      "title": "ExtraAgent",
      "type": "object"
    },
    "GitIdentity": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "default": "pam@code-squad.invalid",
          "description": "Commit author email.",
          "maxLength": 254,
          "minLength": 3,
          "title": "Email",
          "type": "string"
        },
        "name": {
          "default": "pam (code-squad)",
          "description": "Commit author name.",
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "title": "GitIdentity",
      "type": "object"
    },
    "ImplementerConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_protected_paths": {
          "description": "Globs pam may change although protected_paths matches them. Org-only; a repository cannot allow a protected path for itself.",
          "items": {
            "type": "string"
          },
          "title": "Allowed Protected Paths",
          "type": "array",
          "x-merge": "org_only"
        },
        "assignees": {
          "description": "Assignees set on every change request.",
          "items": {
            "type": "string"
          },
          "title": "Assignees",
          "type": "array"
        },
        "branch_template": {
          "default": "pam/{task_key}-{slug}",
          "description": "Branch name template; {task_key} and {slug} are filled in.",
          "maxLength": 200,
          "minLength": 1,
          "title": "Branch Template",
          "type": "string"
        },
        "check_commands": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Commands run in the sandbox to verify the change. Null means detect them from the repository.",
          "title": "Check Commands"
        },
        "commit_template": {
          "default": "feat: {summary}",
          "description": "Commit message template; {summary} is filled in.",
          "maxLength": 200,
          "title": "Commit Template",
          "type": "string"
        },
        "extra_executables": {
          "description": "Executables added to the sandbox allow-list. Org-only.",
          "items": {
            "type": "string"
          },
          "title": "Extra Executables",
          "type": "array",
          "x-merge": "org_only"
        },
        "git_identity": {
          "$ref": "#/$defs/GitIdentity",
          "description": "Git author for implementer commits."
        },
        "labels": {
          "description": "Labels added to every change request.",
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "mr_body_template": {
          "default": "## What\n{summary}\n\n## Why\n{why}\n\n## How tested\n{tests}\n\n## Risks\n{risks}\n",
          "description": "Change request body template with what, why, how tested and risks sections.",
          "maxLength": 8000,
          "title": "Mr Body Template",
          "type": "string"
        },
        "mr_draft": {
          "default": false,
          "description": "Open change requests as drafts.",
          "title": "Mr Draft",
          "type": "boolean"
        },
        "mr_title_template": {
          "default": "{task_key}: {summary}",
          "description": "Change request title template.",
          "maxLength": 200,
          "title": "Mr Title Template",
          "type": "string"
        },
        "protected_paths": {
          "description": "Paths the implementer must not touch. Lower layers may only add.",
          "items": {
            "type": "string"
          },
          "title": "Protected Paths",
          "type": "array",
          "x-mergeable-set": true
        },
        "reviewers": {
          "description": "Reviewers requested on every change request.",
          "items": {
            "type": "string"
          },
          "title": "Reviewers",
          "type": "array"
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxConfig",
          "description": "Sandbox settings."
        }
      },
      "title": "ImplementerConfig",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "default": 50,
          "description": "Platform ceiling for model turns.",
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_prompt_extra_chars": {
          "default": 4000,
          "description": "Platform ceiling for prompt_extra length.",
          "minimum": 1,
          "title": "Max Prompt Extra Chars",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_request_bytes": {
          "default": 1000000,
          "description": "Largest request body the API accepts, in bytes.",
          "minimum": 1,
          "title": "Max Request Bytes",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_run_tokens": {
          "default": 400000,
          "description": "Hard ceiling on model tokens for one run, across all turns.",
          "minimum": 1,
          "title": "Max Run Tokens",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_skill_bytes": {
          "default": 65536,
          "description": "Platform ceiling for bytes per skill.",
          "minimum": 1,
          "title": "Max Skill Bytes",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_skills": {
          "default": 50,
          "description": "Platform ceiling for skills per run.",
          "minimum": 1,
          "title": "Max Skills",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_tokens": {
          "default": 200000,
          "description": "Platform ceiling for tokens per invocation.",
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_total_skill_bytes": {
          "default": 262144,
          "description": "Platform ceiling for total skill bytes.",
          "minimum": 1,
          "title": "Max Total Skill Bytes",
          "type": "integer",
          "x-merge": "org_only"
        },
        "max_wall_clock_seconds": {
          "default": 1800,
          "description": "Platform ceiling for wall-clock seconds.",
          "minimum": 1,
          "title": "Max Wall Clock Seconds",
          "type": "integer",
          "x-merge": "org_only"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "LlmConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_models": {
          "description": "Model aliases a run may use, including per-agent and fallback models. Empty means any. Org-only.",
          "items": {
            "type": "string"
          },
          "title": "Allowed Models",
          "type": "array",
          "x-merge": "org_only"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LiteLLM gateway URL. Org-only (egress).",
          "title": "Base Url",
          "x-merge": "org_only"
        }
      },
      "title": "LlmConfig",
      "type": "object"
    },
    "OpsConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_namespaces": {
          "description": "Kubernetes namespaces darryl may read. Org-only.",
          "items": {
            "type": "string"
          },
          "title": "Allowed Namespaces",
          "type": "array",
          "x-merge": "org_only"
        },
        "argocd_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Argo CD endpoint. Org-only (egress).",
          "title": "Argocd Url",
          "x-merge": "org_only"
        },
        "loki_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Loki endpoint. Org-only (egress).",
          "title": "Loki Url",
          "x-merge": "org_only"
        },
        "max_log_lines": {
          "default": 500,
          "description": "Maximum log lines returned per query.",
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Log Lines",
          "type": "integer"
        },
        "max_query_points": {
          "default": 11000,
          "description": "Maximum points per metrics range query.",
          "minimum": 1,
          "title": "Max Query Points",
          "type": "integer"
        },
        "prometheus_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prometheus endpoint. Org-only (egress).",
          "title": "Prometheus Url",
          "x-merge": "org_only"
        },
        "redaction_patterns": {
          "description": "Regular expressions redacted from tool output. Lower layers may only add.",
          "items": {
            "type": "string"
          },
          "title": "Redaction Patterns",
          "type": "array",
          "x-mergeable-set": true
        }
      },
      "title": "OpsConfig",
      "type": "object"
    },
    "PostingConfig": {
      "additionalProperties": false,
      "properties": {
        "force_dry_run": {
          "default": false,
          "description": "When true, no lower layer can enable external writes. Org-only.",
          "title": "Force Dry Run",
          "type": "boolean",
          "x-merge": "org_only"
        }
      },
      "title": "PostingConfig",
      "type": "object"
    },
    "ProjectEntry": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/VcsAuth"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Credential secret names."
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "API base URL for this project's host.",
          "title": "Base Url"
        },
        "extends": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Profile applied before this entry's own overrides.",
          "title": "Extends"
        },
        "key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Canonical project label used in tags and logs. Defaults to the request key.",
          "title": "Key"
        },
        "match": {
          "description": "Project key or glob. '*' stays within one path segment, '**' crosses them.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Match",
          "type": "string"
        },
        "overrides": {
          "$ref": "#/$defs/SquadFields",
          "description": "Configuration overrides for matching projects."
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "gitlab",
                "github",
                "auto"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "VCS provider for this project.",
          "title": "Provider"
        }
      },
      "required": [
        "match"
      ],
      "title": "ProjectEntry",
      "type": "object"
    },
    "RepoConfigSource": {
      "additionalProperties": false,
      "properties": {
        "allow_head_ref": {
          "default": false,
          "description": "Allow a request to read .squad/config.yml from the change request head. Org-only; off by default.",
          "title": "Allow Head Ref",
          "type": "boolean",
          "x-merge": "org_only"
        }
      },
      "title": "RepoConfigSource",
      "type": "object"
    },
    "ReviewConfig": {
      "additionalProperties": false,
      "properties": {
        "ignore_globs": {
          "description": "Files excluded from review: generated, vendored, lockfiles, snapshots. Lower layers may only add globs.",
          "items": {
            "type": "string"
          },
          "title": "Ignore Globs",
          "type": "array",
          "x-mergeable-set": true
        },
        "max_diff_bytes": {
          "default": 400000,
          "description": "Diffs larger than this are chunked or truncated.",
          "minimum": 1000,
          "title": "Max Diff Bytes",
          "type": "integer"
        },
        "max_findings": {
          "default": 30,
          "description": "Maximum findings published per run.",
          "maximum": 500,
          "minimum": 1,
          "title": "Max Findings",
          "type": "integer"
        },
        "min_confidence_to_publish": {
          "default": "medium",
          "description": "Findings below this confidence are not published.",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Min Confidence To Publish",
          "type": "string"
        },
        "min_severity_inline": {
          "default": "minor",
          "description": "Findings below this severity are summarised, not posted inline.",
          "enum": [
            "nit",
            "minor",
            "major",
            "blocker"
          ],
          "title": "Min Severity Inline",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/VerdictPolicy",
          "description": "Verdict thresholds."
        }
      },
      "title": "ReviewConfig",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "description": "Agents to run when the glob matches.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Agents",
          "type": "array"
        },
        "glob": {
          "description": "Changed-file glob. '**' crosses directories, '*' does not.",
          "maxLength": 256,
          "minLength": 1,
          "title": "Glob",
          "type": "string"
        },
        "requires": {
          "description": "Manifest hints the repository must satisfy, for example 'react'.",
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "glob",
        "agents"
      ],
      "title": "Route",
      "type": "object"
    },
    "RoutingConfig": {
      "additionalProperties": false,
      "properties": {
        "always_run": {
          "description": "Agents that run on every review. Lower layers may only add agents.",
          "items": {
            "type": "string"
          },
          "title": "Always Run",
          "type": "array",
          "x-mergeable-set": true
        },
        "fan_out_concurrency": {
          "default": 4,
          "description": "Specialists called in parallel.",
          "maximum": 32,
          "minimum": 1,
          "title": "Fan Out Concurrency",
          "type": "integer"
        },
        "routes": {
          "description": "Changed-file glob to agent table. Lower layers may only add routes.",
          "items": {
            "$ref": "#/$defs/Route"
          },
          "title": "Routes",
          "type": "array",
          "x-mergeable-set": true
        },
        "sensitive_paths": {
          "description": "Paths that raise the risk tier. Lower layers may only add patterns.",
          "items": {
            "type": "string"
          },
          "title": "Sensitive Paths",
          "type": "array",
          "x-mergeable-set": true
        },
        "size_thresholds": {
          "$ref": "#/$defs/SizeThresholds",
          "description": "Changed-line thresholds for the risk tier. Lower layers may only lower them.",
          "x-merge": "tighten_only"
        },
        "specialist_urls": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Base URL per specialist agent for HTTP fan-out. Org-only.",
          "title": "Specialist Urls",
          "type": "object",
          "x-merge": "org_only"
        },
        "specialists_post": {
          "default": false,
          "description": "Let specialists publish directly instead of returning findings to michael. Lower layers may only keep it false.",
          "title": "Specialists Post",
          "type": "boolean",
          "x-merge": "tighten_only",
          "x-tighten": "false"
