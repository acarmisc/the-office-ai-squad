# Generated by scripts/gen_env_example.py from the bootstrap table in
# code_squad._common.config.bootstrap. Do not edit by hand.
# Copy to .env for a local run. Credentials stay empty here: set them in your
# shell or a secret file, never commit them.

# Agent id this process serves (michael, jim, ...). Required.
AGENT_NAME=

# LiteLLM gateway URL. Required.
LLM_BASE_URL=

# Gateway key. Prefer LLM_API_KEY_FILE.
# Secret: leave empty here and use the *_FILE variant where one exists.
LLM_API_KEY=

# Path to a file holding the gateway key.
LLM_API_KEY_FILE=

# Single-project fallback: gitlab, github or auto.
VCS_PROVIDER=

# Single-project fallback: VCS API base URL.
VCS_BASE_URL=

# Single-project fallback: VCS token. Prefer the file.
# Secret: leave empty here and use the *_FILE variant where one exists.
VCS_TOKEN=

# Single-project fallback: file holding the VCS token.
VCS_TOKEN_FILE=

# Directory of secret files (k8s_files provider).
SECRETS_DIR=/var/run/secrets/squad

# Org configuration file.
SQUAD_CONFIG_FILE=/etc/squad/squad.yaml

# Project registry: a file or a directory.
SQUAD_PROJECTS_DIR=/etc/squad/projects

# Extra profile files, overriding built-ins.
SQUAD_PROFILES_DIR=/etc/squad/profiles

# OTLP collector endpoint for traces.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Redis URL for async jobs (memory store if unset).
SESSION_STORE_URL=

# Specialist base URLs for michael, as key=url pairs.
ORCHESTRATOR_SPECIALIST_URLS=

# Outbound HTTPS proxy for advisory and VCS calls.
EGRESS_PROXY_URL=

# Override the agent's model alias.
AGENT_MODEL_ID=

# Override the agent's output token cap.
AGENT_MAX_TOKENS=

# Override the agent's turn limit.
AGENT_MAX_ITERATIONS=

# Override the agent's temperature (0 to 2).
AGENT_TEMPERATURE=

# Override the agent's prompt file.
AGENT_PROMPT_FILE=

# Shared bearer token for POST /invocations and GET /jobs/{id}. Unset means no token check. Prefer the file.
# Secret: leave empty here and use the *_FILE variant where one exists.
SQUAD_API_TOKEN=

# File holding the shared bearer token. Read once at start-up.
SQUAD_API_TOKEN_FILE=

# Log level of the process.
LOG_LEVEL=INFO

# Comma-separated providers whose webhook route michael registers: gitlab, github. Unset means no /webhooks route exists.
WEBHOOK_PROVIDERS=

# Directory holding gitlab-webhook-secret and github-webhook-secret. Unset means the secret provider is used.
WEBHOOK_SECRETS_DIR=

# Namespace used for specialist service DNS names when no URL is configured.
POD_NAMESPACE=default

# Selects the Kubernetes sandbox for pam when set. When unset, pam uses the local process sandbox, which is for development only.
SANDBOX_NAMESPACE=

# Sandbox pod image. Required when SANDBOX_NAMESPACE is set.
SANDBOX_IMAGE=

# Hard wall-clock limit of a sandbox pod.
SANDBOX_ACTIVE_DEADLINE_SECONDS=1800

# Stored on the sandbox backend but not applied: pods carry no TTL field.
SANDBOX_TTL_SECONDS_AFTER_FINISHED=300

# JSON object with requests and limits for each sandbox pod.
SANDBOX_RESOURCES_JSON={"requests": {"cpu": "250m", "memory": "512Mi"}, "limits": {"cpu": "2", "memory": "2Gi"}}

# Opt-in: a small model classifies requests that the rules cannot classify.
MICHAEL_LLM_INTENT=off

# Opt-in: a model writes a neutral narrative above the deterministic summary.
MICHAEL_LLM_SUMMARY=off

# Model alias for the optional summary narrative.
MICHAEL_SUMMARY_MODEL=sonnet-5-5

# Jira base URL. When set and the jira-api-token secret is available, pam reads task text from Jira (read only) instead of the VCS issue tracker.
JIRA_BASE_URL=
