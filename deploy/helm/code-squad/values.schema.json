{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "code-squad chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "agents",
    "llm",
    "vcs",
    "secrets",
    "config",
    "networkPolicy",
    "sandbox",
    "devops"
  ],
  "definitions": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "portList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/port"
      }
    },
    "cidrList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "valueFrom": {
          "type": "object"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas",
        "resources",
        "env",
        "model"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "env": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/envVar"
          }
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaceOverride": {
          "type": "string"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "michael",
        "jim",
        "angela",
        "dwight",
        "darryl",
        "pam"
      ],
      "properties": {
        "michael": {
          "$ref": "#/definitions/agent"
        },
        "jim": {
          "$ref": "#/definitions/agent"
        },
        "angela": {
          "$ref": "#/definitions/agent"
        },
        "dwight": {
          "$ref": "#/definitions/agent"
        },
        "darryl": {
          "$ref": "#/definitions/agent"
        },
        "pam": {
          "$ref": "#/definitions/agent"
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "apiKeySecret"
      ],
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "apiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "baseUrl"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "gitlab",
            "github",
            "auto"
          ]
        },
        "baseUrl": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org",
        "projects"
      ],
      "properties": {
        "restartOnChange": {
          "type": "boolean"
        },
        "org": {
          "type": "object",
          "description": "Free-form squad.yaml content."
        },
        "projects": {
          "type": "object",
          "description": "Free-form projects.yaml content."
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        }
      }
    },
    "sessionStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "webhooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gitlab": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "secretName": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secretName": {
                "type": "string"
              }
            }
          }
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dnsNamespaceSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "dnsPodSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "prometheusNamespaceSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "ingressControllerNamespaceSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "llmGatewayCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "vcsCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "otlpCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "otlpPorts": {
          "$ref": "#/definitions/portList"
        },
        "advisoryCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "egressProxyCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "egressProxyPorts": {
          "$ref": "#/definitions/portList"
        },
        "sessionStoreCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "sessionStorePorts": {
          "$ref": "#/definitions/portList"
        },
        "kubeAPIServerCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "kubeAPIServerPorts": {
          "$ref": "#/definitions/portList"
        },
        "httpsPorts": {
          "$ref": "#/definitions/portList"
        }
      }
    },
    "devops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNamespaces",
        "clusterWide"
      ],
      "properties": {
        "allowedNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clusterWide": {
          "type": "boolean"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "allowedEgressCIDRs": {
          "$ref": "#/definitions/cidrList"
        },
        "allowedEgressPorts": {
          "$ref": "#/definitions/portList"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    }
  }
}
